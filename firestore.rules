rules_version = '2';

// Schoology 2.0 — security rules.
//
// There is no backend in this app: the client talks to Firestore directly,
// so these rules ARE the backend. Everything a server route used to check in
// Chat_app v1 (session ownership, "is this really your message", size limits)
// is enforced here instead.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Admin power is defined by one hand-seeded document, config/admins, which
    // nothing in the app can write to. Always put this AFTER the ordinary
    // check in an `||` so the extra document read only happens when someone
    // is actually acting as an admin.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && me() in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    // --------------------------------------------------------------- config
    // Readable so the app knows whether to offer the dashboard. Writable by
    // nobody: the admin list is edited in the Firebase console only, which is
    // what stops anyone promoting themselves.
    match /config/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------- users
    // Public-ish directory so people can be found by username in search.
    // Only ever contains a display name, a lowercase search key and an
    // avatar colour — no email address, no credentials.
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && userId == me()
        && request.resource.data.uid == me()
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.usernameLower == request.resource.data.username.lower();

      // A username is permanent: it is the handle other people search for.
      // Note the `blocked` clause: you may update your own profile, but you
      // may not change your own blocked flag, so nobody can unblock themselves.
      allow update: if (signedIn()
          && userId == me()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.usernameLower == resource.data.usernameLower
          && request.resource.data.get('blocked', false) == resource.data.get('blocked', false))
        || isAdmin();

      // Admins remove the directory entry. The Firebase Authentication record
      // behind it can only be deleted from the console — that needs the Admin
      // SDK, which needs a server, which needs the paid plan.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- chats
    // Document id is the two member uids, sorted and joined with "_", so a
    // pair of people can only ever have one conversation document and either
    // side can derive its id without a lookup.
    match /chats/{chatId} {

      function isMember() {
        // `resource` is null when the document does not exist yet, and
        // dereferencing it would abort the whole rule evaluation rather than
        // just denying — hence the explicit guard.
        return signedIn() && resource != null && me() in resource.data.members;
      }

      function joiningAsMember() {
        return signedIn() && me() in request.resource.data.members;
      }

      function canonicalId() {
        return request.resource.data.members[0] < request.resource.data.members[1]
          && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      }

      // Before two people have ever spoken, the client looks the conversation
      // up to decide whether to create it. That read hits a document that does
      // not exist, so it is allowed purely on the id — which, by construction,
      // is the two uids. Nothing is disclosed: the reader is asking about a
      // conversation they would be half of.
      allow get: if isMember()
        || (signedIn() && resource == null && chatId.split('_').hasAny([me()]));

      // Admins need this to find every conversation belonging to a user they
      // are removing — they are not a member of any of them.
      allow list: if isMember() || isAdmin();

      allow create: if joiningAsMember()
        && request.resource.data.members.size() == 2
        && canonicalId();

      // Members may update conversation metadata (last message preview,
      // unread counters, typing flags, read markers) but may never rewrite
      // who is in the conversation.
      allow update: if isMember()
        && joiningAsMember()
        && request.resource.data.members == resource.data.members;

      // Deleting a conversation destroys it for both people, so it is limited
      // to the two of them (and to admins cleaning up after a removed user).
      // Hiding a conversation from your own list is an ordinary update above.
      allow delete: if isMember() || isAdmin();

      // ------------------------------------------------------------ messages
      match /messages/{messageId} {

        // Membership is derived from the conversation id rather than read out
        // of the conversation document. The id IS the two uids, sorted and
        // joined — `canonicalId()` above enforces that at creation and the
        // member list is frozen afterwards, so the two are equivalent.
        //
        // Deriving it costs no document read, which matters here because this
        // runs on every message read, sent and deleted. It also cannot throw:
        // a get() against a conversation document that has already been
        // deleted mid-purge returns null, and dereferencing that aborts rule
        // evaluation instead of simply denying.
        function inThisChat() {
          return signedIn() && chatId.split('_').hasAny([me()]);
        }

        // Sending additionally requires the conversation to actually exist, so
        // messages cannot be stashed under a conversation nobody ever opened.
        function conversationExists() {
          return exists(/databases/$(database)/documents/chats/$(chatId));
        }

        // Admins need to read a conversation's messages in order to delete
        // them when removing a user; they are a member of none of them.
        allow read: if inThisChat() || isAdmin();

        allow create: if inThisChat()
          && conversationExists()
          && request.resource.data.senderId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // Images are inlined as compressed data URLs because Cloud Storage
          // is not part of the free Spark plan. Cap them well under the 1 MiB
          // Firestore document limit.
          && (!('image' in request.resource.data.keys())
              || request.resource.data.image == null
              || (request.resource.data.image is string
                  && request.resource.data.image.size() <= 600000));

        // Used for read receipts only — the body of a message is immutable.
        allow update: if inThisChat()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt;

        // Your own message, any message in a conversation you are deleting,
        // or an admin clearing out a removed user's data.
        allow delete: if inThisChat() || isAdmin();
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
