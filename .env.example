# Copy this file to `.env` and paste in the values Firebase shows you under
# Project settings -> General -> Your apps -> Web app -> SDK setup (Config).
#
# These are NOT secrets. A Firebase web API key identifies your project; it
# grants no access on its own. What actually protects your data is
# firestore.rules, which ships in this repo.
#
# .env is gitignored. Everything below is free on the Spark plan — no billing
# account, no credit card.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Usernames are turned into synthetic sign-in addresses
# (alice -> alice@aura-users.invalid). Change only if you have a reason to.
# VITE_AUTH_EMAIL_DOMAIN=aura-users.invalid

# Set to 1 in .env.local to point the app at `firebase emulators:start`
# instead of your real project while developing.
# VITE_USE_EMULATORS=1
