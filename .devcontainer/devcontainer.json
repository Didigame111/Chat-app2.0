{
  "name": "Schoology 2.0",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install && npm install -g firebase-tools && node scripts/write-env.mjs",
  "forwardPorts": [5173, 4173, 4000, 8080, 9099],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "openPreview" },
    "4173": { "label": "Production preview" },
    "4000": { "label": "Firebase Emulator UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "toba.vsfire"]
    }
  }
}
